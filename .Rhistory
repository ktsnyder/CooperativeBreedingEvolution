plotspectrograms <- function(DirLoc, outdir, foldernums = NA) {
require(warbleR)
require(stringr)
DirList <- list.dirs(DirLoc, recursive = FALSE, full.names = FALSE)
print(DirList)
par(mfrow = c(10,1))
par(mar = c(1,4,1,1))
if (is.na(foldernums)) {
DirList <- DirList
} else {
DirList <- DirList[foldernums]
}
for (i in 1:length(DirList)) {
#temppath <- paste0(getwd(),"/",SongsNotYetFoundFiles[i])
#temppath <- paste0(DirOfBirds,"/",SongsNotYetFoundFiles[i])
temppath <- paste0(DirLoc, DirList[i])
print(temppath)
DPHFolders <- list.files(temppath)
print(DPHFolders)
for (j in 1:length(DPHFolders)) {
temppath2 <- paste0(temppath,"/",DPHFolders[j])
SongFiles <- list.files(temppath2)
print(DPHFolders[j])
print(length(SongFiles))
print(Sys.time())
if (length(SongFiles) > 0) {
pdf(paste0(outdir, DirList[i],"_", DPHFolders[j],"_AllSpectrograms.pdf"), height = 11, width= 8)
par(mfrow = c(10,1))
par(mar = c(1,4,1,1))
for (k in 1:length(SongFiles))  {
tempfile <- paste0(temppath2,"/",SongFiles[k])
tempWave <- tryCatch({
tempWave <- read_wave(tempfile)
fileLabel <- str_sub(SongFiles[k], start= -23)
# change the actual length of the Wave object!
#tempWave@left <- c(tempWave@left, rep(0,times = tempWave@samp.rate*30-length(tempWave@left)))
spectro(tempWave, wl = 256, grid = FALSE, scale = FALSE, flim=c(0,12), flab = fileLabel, cexlab = 0.75, fastdisp = FALSE)
}, error = function(e) {
print(tempfile)
})  # end tryCatch
} # end for k
dev.off()
} # end if length SongFiles > 0
} # end for j
} # end for i
# print(Sys.time())
}
